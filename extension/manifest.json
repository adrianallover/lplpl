{
  "manifest_version": 3,
  "name": "HideSeek Joiner",
  "version": "1.0.0",
  "description": "Type a Roblox username, see what game they're in, and jump straight into their server. Perfect for hide & seek with friends.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "HideSeek Joiner",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://*.roblox.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/users/*/profile*"],
      "js": ["content/profile.js"],
      "css": ["content/profile.css"],
      "run_at": "document_idle"
    }
  ]
}
